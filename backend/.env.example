# Copiar a .env y completar localmente. Nunca subir .env ni sus secretos al repositorio.
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Oracle XE 21c: SERVICE_NAME recomendado, por ejemplo localhost:1521/XEPDB1
DB_CONNECT_STRING=localhost:1521/XEPDB1
DB_USER=USUARIO_DE_CONEXION
DB_PASSWORD=CAMBIAR_LOCALMENTE
DB_POOL_MIN=1
DB_POOL_MAX=5

# Crear un secreto aleatorio largo (mínimo 32 bytes). No reutilizar credenciales Oracle.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
# Duración del token. La sesión se renueva sola con el uso y se cierra tras 20 minutos de inactividad.
JWT_EXPIRES_IN=30m

# Opcionales: si no se definen se usan estos valores.
ORDER_CANCEL_WINDOW_MINUTES=15
ORDER_UNCLAIMED_DAYS=4
INSIGHTS_HISTORY_DAYS=90
INSIGHTS_SAFETY_DAYS=2
INSIGHTS_COVERAGE_DAYS=15
ALERT_RECEPTION_DAYS=2
ALERT_UNVERIFIED_MINUTES=30

# Correo opcional: sin SMTP_HOST los avisos solo se ven en la campana y en Mis pedidos.
MAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
